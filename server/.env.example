PORT=4000

# Neon: Dashboard -> Connect. Ai nevoie de DOUĂ adrese.
# 1) Cu pooler (hostul conține "-pooler"): folosită de aplicație la rulare
DATABASE_URL="postgresql://USER:PAROLA@ep-xxxx-pooler.REGIUNE.aws.neon.tech/neondb?sslmode=require"
# 2) Directă (fără "-pooler"): folosită de Prisma CLI pentru migrări
DIRECT_URL="postgresql://USER:PAROLA@ep-xxxx.REGIUNE.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET=pune-aici-un-sir-lung-si-aleator

# Email (resetare parolă). Fără cheie, codul apare doar în consola serverului.
RESEND_API_KEY=
EMAIL_FROM="Stilora <onboarding@resend.dev>"

# Google Sign-In (Google Cloud Console -> Credentials). Pune ID-urile pe care le folosește aplicația.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Adresa publică a serverului (fără / la final). Fără ea, imaginile din catalog folosesc adresa din cerere.
PUBLIC_URL=https://numele-tau.onrender.com
