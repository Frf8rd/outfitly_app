# Dezvoltare locală: IP-ul calculatorului din rețeaua Wi-Fi. În build-urile EAS valoarea vine din eas.json.
EXPO_PUBLIC_API_URL=http://192.168.1.15:4000/api

# Google Sign-In (aceleași ID-uri ca în server/.env)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
